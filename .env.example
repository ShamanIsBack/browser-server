# Shared secret between the client (e.g. the OpenClaw skill) and this server.
# Sent by the client as the X-API-Key header. Minimum 16 characters — a shorter
# key is refused at request time and the server answers 503.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Bind address. 127.0.0.1 keeps the server reachable only from this machine.
# Change it only if the client runs elsewhere, and only behind a firewall or
# an authenticating reverse proxy — this server has no TLS and no rate limiting.
HOST=127.0.0.1
PORT=8765

# Run Chromium without a visible window. Set to false to watch the agent work.
HEADLESS=true

# Dump each turn's screenshot and DOM marks to ./debug/turn_NN/ (gitignored).
DEBUG=false
